# Обязательные переменные
BOT_TOKEN=your_telegram_bot_token
DB_URL=jdbc:postgresql://localhost:5432/avengers
DB_USER=postgres
DB_PASSWORD=postgres

# Необязательные переменные (имеют значения по умолчанию)
# Время кулдауна ежедневной награды в минутах (по умолчанию 1440 = 24 часа)
DAILY_COOLDOWN_MINUTES=1440
# Интервал проверки планировщика уведомлений в минутах (по умолчанию 30)
DAILY_NOTIFICATION_INTERVAL_MINUTES=30